APP_NAME=Autonomous Research Agent

ENVIRONMENT=local

DEBUG=false

SECRET_KEY=replace-with-a-64-character-random-secret

DATABASE_URL=postgresql://postgres:postgres@db:5432/research_db

POSTGRES_DB=research_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_URL=redis://redis:6379/0

OPENAI_API_KEY=

LLM_MODEL=gpt-4o-mini

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PERSIST_DIR=/app/data/chroma

FAISS_INDEX_PATH=/app/data/faiss/research.index

USE_CELERY=false

AUTO_CREATE_TABLES=true

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_MINUTES=10080

RATE_LIMIT_REQUESTS=120

RATE_LIMIT_WINDOW_SECONDS=60

RESEARCH_MAX_SOURCES=6

RESEARCH_MAX_DEPTH=2

BROWSER_TIMEOUT_MS=15000

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]